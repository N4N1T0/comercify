{
  "name": "comercify",
  "version": "1.2.0",
  "description": "🛒 E-commerce utility functions by the community, for the community.",
  "type": "commonjs",
  "bin": {
    "comercify-cli": "./dist/cli/index.js"
  },
  "exports": {
    "./adrian": {
      "import": {
        "types": "./dist/adrian/index.d.mts",
        "default": "./dist/adrian/index.mjs"
      },
      "require": {
        "types": "./dist/adrian/index.d.ts",
        "default": "./dist/adrian/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "adrian": [
        "./dist/adrian/index.d.ts"
      ]
    }
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "src/*/*.ts",
    "!src/**/*.test.ts",
    "!src/cli/**"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky",
    "cli": "tsx src/cli/index.ts"
  },
  "lint-staged": {
    "*.ts": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "keywords": [
    "ecommerce",
    "utils",
    "open-source",
    "typescript"
  ],
  "author": "Adrián Álvarez",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/N4N1T0/comercify.git"
  },
  "homepage": "https://github.com/N4N1T0/comercify#readme",
  "bugs": {
    "url": "https://github.com/N4N1T0/comercify/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@types/node": "^20.11.0",
    "eslint": "9.32.0",
    "globals": "^16.3.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.2",
    "prettier": "3.6.2",
    "tsup": "8.5.0",
    "tsx": "^4.7.0",
    "typescript": "5.8.3",
    "typescript-eslint": "^8.38.0",
    "vitest": "3.2.4"
  },
  "packageManager": "pnpm@10.14.0"
}
